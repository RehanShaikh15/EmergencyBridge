# Hosted OpenAI-compatible endpoint. Keep secrets on the server only.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Comma-separated frontend origins for local development; * is allowed only for local demos.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
